# Copy to .env and fill in real values (.env is gitignored).
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# At least 32 random bytes: [Convert]::ToBase64String((New-Object byte[] 64 | % { Get-Random -Max 256 }))
JWT_SECRET=your-random-jwt-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
# true in production (HTTPS only)
COOKIE_SECURE=false

# Required — free v4 read access token at themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=your-tmdb-v4-read-access-token
# Optional — no key means no captions; free at opensubtitles.com/consumers
OPENSUBTITLES_API_KEY=

# Optional — without these only guest login works; the redirect URI must be registered on the OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
# Required in prod — Turnstile widget secret (dash.cloudflare.com → Turnstile); empty skips the guest bot check
# Scripts/e2e: Cloudflare's always-pass test secret 1x0000000000000000000000000000000AA (see README "Scripts and e2e suites")
TURNSTILE_SECRET_KEY=
# Where the browser lands after a provider sign-in
FRONTEND_URL=http://localhost:5173
# Comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Inactive guests are deleted after this many days
GUEST_RETENTION_DAYS=7
# Spring cron (sec min hour day month weekday) for the guest sweep and the expired-token prune
GUEST_CLEANUP_CRON=0 17 3 * * *
TOKEN_CLEANUP_CRON=0 32 3 * * *
# false only for local scripted runs
RATE_LIMIT_ENABLED=true
