# Copy this file to .env and fill in real values. .env is gitignored.
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
# Random secret used to sign JWTs — at least 32 bytes, e.g. generate with:
#   [Convert]::ToBase64String((New-Object byte[] 64 | % { Get-Random -Max 256 }))
JWT_SECRET=your-random-jwt-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
# Auth cookies: false for local HTTP dev; true in production (HTTPS).
COOKIE_SECURE=false

# Required — the app fails to start without it (unresolved placeholder).
# Free v4 read access token at themoviedb.org/settings/api.
TMDB_READ_ACCESS_TOKEN=your-tmdb-v4-read-access-token

# Optional — subtitles are an enhancement and degrade gracefully without a
# key (no captions, no error). Free key at opensubtitles.com/consumers.
OPENSUBTITLES_API_KEY=

# Optional — comma-separated frontend origins allowed to call the API.
# Defaults to the Vite dev server; set this when deploying.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional — guest accounts with no activity for this many days are deleted
# by the daily sweep, along with everything they own.
GUEST_RETENTION_DAYS=7

# Optional — cron schedule (Spring format: sec min hour day month weekday)
# for the guest cleanup sweep. Default below is 03:17 every day.
GUEST_CLEANUP_CRON=0 17 3 * * *

# Optional — cron schedule for pruning expired refresh tokens. Separate from
# the guest sweep, which only removes tokens belonging to guests it deletes:
# a provider-backed session abandoned without logging out would otherwise keep
# its row forever. Default below is 03:32 every day, after the guest sweep.
TOKEN_CLEANUP_CRON=0 32 3 * * *
